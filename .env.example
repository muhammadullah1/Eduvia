# Eduvia frontend environment template. Copy to `.env.local` for local overrides (git-ignored) or set
# these in Vercel → Project → Settings → Environment Variables. Placeholders only; VITE_* values are
# embedded in the public bundle, so never put secrets here.

# [required for staging/production builds] API base URL including /api, e.g. https://<api-host>/api.
# `vite build` fails without it (outside --mode development/test). In `npm run dev` leave it unset:
# requests go to the relative /api and Vite proxies them to http://localhost:5000.
VITE_API_URL=https://api.your-domain.example.com/api

# Leave unset: the R2 bucket is private and files load through presigned URLs from the API.
VITE_R2_PUBLIC_BASE_URL=
